<Window x:Class="RocketLeagueCounter.LobbyRanksView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rank Lobby"
        Width="430"
        Height="460"
        MinWidth="380"
        MinHeight="350"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#F0000000"
            CornerRadius="12"
            Padding="12"
            BorderBrush="#444444"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TITOLO -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="RANK LOBBY"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <Button Content="×"
                        Width="25"
                        Height="25"
                        HorizontalAlignment="Right"
                        Background="#D9363E"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="17"
                        FontWeight="Bold"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- MODALITÀ -->
            <UniformGrid Grid.Row="1"
                         Columns="4"
                         Margin="0,0,0,10">

                <Button x:Name="SoloButton"
                        Content="1v1"
                        Tag="Solo"
                        Click="ModeButton_Click"
                        Margin="2"
                        Padding="4"
                        Background="#333333"
                        Foreground="White"
                        BorderBrush="#666666"/>

                <Button x:Name="DoublesButton"
                        Content="2v2"
                        Tag="Doubles"
                        Click="ModeButton_Click"
                        Margin="2"
                        Padding="4"
                        Background="#277D45"
                        Foreground="White"
                        BorderBrush="#666666"/>

                <Button x:Name="StandardButton"
                        Content="3v3"
                        Tag="Standard"
                        Click="ModeButton_Click"
                        Margin="2"
                        Padding="4"
                        Background="#333333"
                        Foreground="White"
                        BorderBrush="#666666"/>

                <Button x:Name="TournamentButton"
                        Content="Tornei"
                        Tag="Tournament"
                        Click="ModeButton_Click"
                        Margin="2"
                        Padding="4"
                        Background="#333333"
                        Foreground="White"
                        BorderBrush="#666666"/>
            </UniformGrid>

            <!-- INFORMAZIONI -->
            <TextBlock x:Name="ModeDescription"
                       Grid.Row="2"
                       Text="2v2 — Doubles"
                       Foreground="#BBBBBB"
                       FontSize="11"
                       Margin="2,0,0,8"/>

            <!-- TABELLA -->
            <Border Grid.Row="3"
                    Background="#171717"
                    BorderBrush="#444444"
                    BorderThickness="1"
                    CornerRadius="6">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel x:Name="PlayersPanel"
                                Margin="6">

                        <!-- SQUADRA BLU -->
                        <TextBlock Text="SQUADRA BLU"
                                   Foreground="#65B7FF"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="3,5,3,6"/>

                        <Grid Margin="2,0,2,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="65"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Giocatore"
                                       Foreground="#999999"
                                       FontSize="10"/>

                            <TextBlock Grid.Column="1"
                                       Text="Rank / Divisione"
                                       Foreground="#999999"
                                       FontSize="10"/>

                            <TextBlock Grid.Column="2"
                                       Text="MMR"
                                       Foreground="#999999"
                                       FontSize="10"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <ItemsControl x:Name="BluePlayersList"
                                      ItemsSource="{Binding BluePlayers}">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="125"/>
                                            <ColumnDefinition Width="65"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding RankText}"
                                                   Foreground="{Binding RankColor}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding MmrText}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1"
                                Background="#444444"
                                Margin="0,8"/>

                        <!-- SQUADRA ARANCIONE -->
                        <TextBlock Text="SQUADRA ARANCIONE"
                                   Foreground="#FFAD70"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="3,5,3,6"/>

                        <ItemsControl x:Name="OrangePlayersList"
                                      ItemsSource="{Binding OrangePlayers}">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="125"/>
                                            <ColumnDefinition Width="65"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding RankText}"
                                                   Foreground="{Binding RankColor}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding MmrText}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- NOTA -->
            <TextBlock Grid.Row="4"
                       Text="Dati dimostrativi — non sono rank reali"
                       Foreground="#888888"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       Margin="0,9,0,0"/>
        </Grid>
    </Border>
</Window>